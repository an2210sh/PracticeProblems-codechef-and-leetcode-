#include <bits/stdc++.h>
using namespace std;
bool isodd(int n){
    if(n%2!=0)
    return true;
    else
    return false;
}
int main() {
    int t,p,q;
    cin>>t;
    while(t--){
        cin>>p>>q;
        if(!isodd((p+q)/2))
        cout<<"alice\n";
        else
        cout<<"bob\n";
        
        
    }
}
