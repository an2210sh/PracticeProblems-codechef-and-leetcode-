#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int x,y;
	    cin>>x>>y;
	    if(x%2==0){
	    if(x/2<=y)
	    cout<<"yes\n";
	       else
	    cout<<"no\n";
	    }
	    else{
	        if(x/2+1<=y)
	        cout<<"yes\n";
	        else
	        cout<<"no\n";
	    }
	 
	}

}
