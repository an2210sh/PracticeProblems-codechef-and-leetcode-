#include <bits/stdc++.h>
using namespace std;
bool isPrime(int n){
    if(n==2)
    return 1;
    if(n==1)
    return 0;
    for(int i=2;i<=pow(n,0.5);i++){
        if(n%i==0)
        return false;
    }return 1;
}
int main() {
	int t;
	cin>>t;
	while(t--){
	    int n;
	    cin>>n;
	    isPrime(n)?cout<<"yes\n":cout<<"no\n";
	}

}
