#include <bits/stdc++.h>
using namespace std;
bool isOdd(int n){
    if(n%2!=0)
    return 1;
    return 0;
}
int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int n;
	    cin>>n;
	    int a[n];
	    int o=0;
	    int e=0;
	    for(int i=0;i<n;i++){
	    cin>>a[i];
	    if(isOdd(a[i]))
	    o++;
	    else
	    e++;
	    }
	    cout<<o<<" "<<e<<endl;
	    if(2*min(o,e)<n)
	    cout<<2*min(o,e)+1;
	    else
	    cout<<n;
	    cout<<endl;
	}

}
