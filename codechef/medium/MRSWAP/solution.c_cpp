#include <bits/stdc++.h>
using namespace std;

int main() {
int t;
cin>>t;
while(t--){
    int n;
    cin>>n;
    int m=2*n;
    int a[m];
    for(int i=0;i<m;i++)
    cin>>a[i];
    for(int i=0;i<m/2;i++){
        if(a[i]<=a[m-1-i])
        swap(a[i],a[m-1-i]);
    }
    int sum=0;
     for(int i=0;i<n;i++)
     sum+=a[i];
     cout<<sum<<"\n";
    
}
}
