#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int n,bal=0;
	    cin>>n;
	    int A[n+1];
	    for(int i=1;i<=n;i++)
	    cin>>A[i];
	    int i=0;
	    for(int j=2;j<=n;j++) {
	        if(A[j]>=j-i){
	            bal+=A[j]-j+i;
	            i=j;
	        }
	       else
	       continue;
	    }
	    cout<<bal<<endl;
	}

}
