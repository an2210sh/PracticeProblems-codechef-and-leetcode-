#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
int t;
cin>>t;
while(t--){
    int n;
    cin>>n;
    int a[n];
    for(int i=0;i<n;i++)
    cin>>a[i];
    for(int i=1;i<n-1;i+=2){
        if(a[i]<min(a[i-1]a[i+1]))
        a[i-1]=a[i+1]=a[i];
    }
    int sum=0;
    for(int i=0;i<n;i++)
    sum+=a[i];
    cout<<sum<<"\n";
}
}
