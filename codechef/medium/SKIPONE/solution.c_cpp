#include <bits/stdc++.h>
using namespace std;
int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int n,k,ans;
	    cin>>n>>k;
	    int a[n];
	    for(int i=1;i<=n;i++){
	    cin>>a[i];
	    	    ans=i;
	    if(k-a[i]<0)
	    break;
	    else{
	    k-=a[i];
	   // cout<<k<<" ";
	    }

    	}
       cout<<ans+1<<"\n";
}
}
