#include <bits/stdc++.h>
using namespace std;
int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int n,k,ans;
	    cin>>n>>k;
	    int a[n];
	    for(int i=0;i<n;i++){
	    cin>>a[i];
	    ans=i+1;
	    if(k-a[i]<0)
	    break;
	    else
	    k=k-a[i];
    	}
       cout<<ans<<"\n";
}
}
